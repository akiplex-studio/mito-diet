<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.47: やることリマインダーを、アプリを閉じていても・省電力(Doze)中でも指定時刻ちょうどに通知するため
         正確なアラームを使う。USE_EXACT_ALARMはユーザー許可不要で付与される（リマインダー機能が主目的のため妥当）。
         ※Play Store申請時はUSE_EXACT_ALARMの用途申告が必要になる可能性あり。要確認 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- v1.51: 「📷 カメラで撮影」（input capture）でカメラが起動しない不具合の修正。
         Android11以降のパッケージ可視性制限により、<queries>が無いと Capacitor 内部の
         resolveActivity(ACTION_IMAGE_CAPTURE) が null を返し、カメラを開かず
         ファイルピッカーへフォールバックしてしまう。CAMERA権限はあえて宣言しない
         （宣言すると実行時の許可ダイアログが必要になる。撮影インテント自体は権限不要） -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
