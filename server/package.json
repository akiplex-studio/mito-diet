{
  "name": "mito-meal-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "ミトコンドリア・ダイエット 料理写真解析バックエンド（個人利用MVP）",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/quota.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@upstash/redis": "^1.38.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
