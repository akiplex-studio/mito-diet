# このファイルを .env にコピーして実際の値を入れる（.env はコミットされません）
# cp .env.example .env

# Anthropic APIキー（https://platform.claude.com で発行）— バックエンドのみが保持
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ヘルス連携（個人用）のみで使用する簡易認証シークレット（長いランダム文字列に変更すること）
# /api/health-data 系・/api/health-debug でのみ照合する。/api/analyze-meal はデバイスID方式のため使わない
# 生成例: openssl rand -hex 32
APP_SHARED_SECRET=change-me-to-a-long-random-string

# 待受ポート
PORT=8787

# Upstash Redis（REST API）— デバイス単位の日次利用枠のカウンタ保存先
# https://console.upstash.com で無料のRedisデータベースを作成し、REST URL/TOKENを控える
# 未設定の場合はメモリストアのみで動作する（ローカル開発用。Renderの再起動でカウンタが消える）
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# 1デバイスあたりの解析回数上限（1日・暴走防止）
DEVICE_DAILY_LIMIT=6

# 全デバイス合算の日次コスト上限（USD・暴走防止）
GLOBAL_DAILY_COST_USD=1.5

# CORS許可オリジン（カンマ区切り・省略時は GitHub Pages / localhost / Capacitor を許可）
# ALLOWED_ORIGINS=https://akiplex-studio.github.io,http://localhost:8080
